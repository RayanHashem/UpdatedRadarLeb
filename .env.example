APP_NAME=RadarLeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=radarleb
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Dev-only auto-auth helper (used by app/Http/Middleware/DevAutoAuth.php).
# Leave blank in production. The middleware refuses to run unless APP_ENV=local
# AND the host is local-like, so this won't accidentally activate.
DEV_PASSWORD=

# Filament admin panel
ADMIN_MAX_EXECUTION_TIME=300

# Trusted proxies (comma-separated, or *). Leave blank for local dev. Read in
# bootstrap/app.php — env() is fine there because it runs before config:cache.
APP_TRUSTED_PROXIES=

# DatabaseSeeder default password. Used by `php artisan db:seed` when creating
# the public test user. NEVER use this default in any environment that touches
# real users — change it locally and re-seed.
SEEDER_PASSWORD=

# Operational health probe (routes/api.php /db-check). When set to a non-empty
# value, /db-check responds only if `?secret=…` matches via timing-safe compare.
# In APP_ENV=local the secret is bypassed for developer convenience.
HEALTH_CHECK_SECRET=

# Public support phone shown in the dashboard help overlay. Replaces the
# previously-hardcoded 71484833 in three Vue files. Read via config/contact.php.
RADARLEB_SUPPORT_PHONE=71484833
