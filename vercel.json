{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "composer install --no-dev --no-interaction --optimize-autoloader && npm install && npm run build && php artisan config:cache && php artisan route:cache && php artisan view:cache",
    "installCommand": "npm install",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/assets/(.*)", "dest": "/public/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/css/(.*)", "dest": "/public/css/$1" },
        { "src": "/js/(.*)", "dest": "/public/js/$1" },
        { "src": "/storage/(.*)", "dest": "/public/storage/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/favicon-(.*).png", "dest": "/public/favicon-$1.png" },
        { "src": "/apple-touch-icon.png", "dest": "/public/apple-touch-icon.png" },
        { "src": "/android-chrome-(.*).png", "dest": "/public/android-chrome-$1.png" },
        { "src": "/site.webmanifest", "dest": "/public/site.webmanifest" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/sw.js", "dest": "/public/sw.js" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
